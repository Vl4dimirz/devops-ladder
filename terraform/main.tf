// ============================================================================
// main.tf — จัดการเครื่องที่ "มีอยู่แล้ว" ด้วย Terraform
// ============================================================================
// ⭐⭐ ทำไมถึงเริ่มด้วย import ไม่ใช่ create
//
//    บทเรียน Terraform เกือบทั้งหมดเริ่มจากศูนย์ สร้างของใหม่ทั้งหมด
//    แต่งานจริงแทบไม่เคยเป็นแบบนั้น — ของมีอยู่แล้ว มีคนกดสร้างไว้ด้วยมือ
//    และงานที่ได้รับจ้างคือ "เอาของที่มีอยู่มาจัดการให้เป็นระบบ"
//
//    import จึงเป็นคำสั่งที่ใช้จริงมากกว่า และยากกว่า เพราะต้องเขียนโค้ด
//    ให้ตรงกับของที่มีอยู่เป๊ะ ไม่งั้น Terraform จะเสนอแก้หรือลบทิ้ง
//
// ⛔⛔ สิ่งที่อันตรายที่สุดของ Terraform คือมันลบของที่มันดูแลได้
//    `terraform destroy` หรือแม้แต่ `apply` ที่เผลอ จะลบเครื่องจริงทิ้ง
//    ไฟล์นี้จึงใส่ prevent_destroy ไว้ทุกที่ที่ลบแล้วเจ็บ
// ============================================================================

terraform {
  required_version = ">= 1.5"

  required_providers {
    digitalocean = {
      source = "digitalocean/digitalocean"
      // ⚠️ ล็อกช่วงเวอร์ชันเสมอ ไม่งั้นวันหนึ่ง provider เปลี่ยนรุ่นใหญ่
      //    แล้ว plan จะเสนอแก้ของที่ไม่ได้แตะเลย
      version = "~> 2.0"
    }
  }
}

provider "digitalocean" {
  // ⛔ ห้ามใส่ token ในไฟล์นี้เด็ดขาด
  //    provider อ่านจากตัวแปรสภาพแวดล้อม DIGITALOCEAN_TOKEN เอง
  //    ตั้งด้วย  export DIGITALOCEAN_TOKEN=...  ก่อนรัน
  //    ⚠️ token ของ DigitalOcean สร้างและลบเครื่องได้ = ใช้เงินได้
  //       ให้สร้างแบบจำกัดสิทธิ์เฉพาะ droplet กับ firewall เท่านั้น
}

// ── นำเครื่องที่มีอยู่แล้วเข้ามาอยู่ในความดูแล ──────────────────────────────
// ⭐ import block มีตั้งแต่ Terraform 1.5 ดีกว่าคำสั่ง `terraform import` แบบเดิม
//    เพราะมันอยู่ในโค้ด จึงถูกรีวิวได้ และ `plan` บอกล่วงหน้าว่าจะเกิดอะไร
//    ส่วนคำสั่งแบบเดิมแก้ state ทันทีโดยไม่มีใครได้เห็นก่อน
import {
  to = digitalocean_droplet.ladder
  id = var.droplet_id
}

resource "digitalocean_droplet" "ladder" {
  name   = var.droplet_name
  region = var.region
  size   = var.droplet_size
  image  = var.droplet_image

  // ⛔⛔⛔ บรรทัดนี้เกือบทำให้เซิร์ฟเวอร์ถูกลบทิ้ง — เรื่องจริง 2026-08-28
  //
  //    รอบแรกลืมประกาศ monitoring ทั้งที่เครื่องจริงเปิดไว้
  //    Terraform เห็นว่าค่าไม่ตรง (true -> false) แล้วรายงานว่า
  //
  //        ~ monitoring = true -> false # forces replacement
  //        Plan: 1 to import, 1 to add, 0 to change, 1 to destroy
  //
  //    คือจะ **ลบเครื่องที่รันอยู่ทิ้งแล้วสร้างใหม่** ไอพีเปลี่ยน ข้อมูลหายหมด
  //    ทั้งที่คำสั่งที่พิมพ์คือ plan ธรรมดา ไม่ได้สั่งลบอะไรเลย
  //    หยุดได้เพราะ prevent_destroy ข้างล่างเท่านั้น
  //
  // ⭐ บทเรียน: คุณสมบัติบางอย่างแก้ไม่ได้หลังสร้าง ผู้ให้บริการไม่มี API ให้เปลี่ยน
  //    Terraform จึงเลือก "ลบแล้วสร้างใหม่" และเขียนไว้แค่ในบรรทัดเล็กๆ ว่า
  //    forces replacement
  //    ⛔ อ่านบรรทัด `Plan:` ทุกครั้งก่อน apply ถ้า to destroy ไม่ใช่ 0 ให้หยุดอ่านก่อน
  monitoring = true

  // ⚠️ ค่าพวกนี้ต้องตรงกับของจริงเป๊ะ ไม่งั้น plan จะเสนอสร้างใหม่แทนที่จะรับมาดูแล
  //    ดูค่าจริงได้จากในเครื่องเอง โดยไม่ต้องใช้ token:
  //      curl http://169.254.169.254/metadata/v1/id
  //      curl http://169.254.169.254/metadata/v1/region

  lifecycle {
    // ⛔⛔ ด่านสุดท้ายที่กัน terraform destroy ไม่ให้ลบเครื่องจริงทิ้ง
    //    ถ้าอยากลบจริงๆ ต้องมาแก้บรรทัดนี้ก่อน = ต้องตั้งใจสองครั้ง
    prevent_destroy = true

    // ⚠️ ไม่ให้ Terraform ไปยุ่งกับสองอย่างนี้
    //    image  = เครื่องที่รันอยู่ถูกอัปเดตไปแล้ว ไม่ตรงกับ image ตอนสร้าง
    //    ssh_keys = กุญแจถูกจัดการโดย Ansible ซึ่งเป็นเครื่องมือที่เหมาะกว่า
    //    ⭐ การแบ่งงานให้ชัดว่าเครื่องมือไหนดูแลอะไร สำคัญกว่าการใช้ตัวเดียวทำทุกอย่าง
    //    vpc_uuid = DigitalOcean กำหนดให้เองตอนสร้าง ถ้าไม่ระบุจะถือว่าเปลี่ยนทุกครั้ง
    //    tags     = ปล่อยให้จัดการจากหน้าเว็บได้ ไม่ต้องให้ Terraform ทะเลาะด้วย
    ignore_changes = [image, ssh_keys, vpc_uuid, tags]
  }
}

// ── ไฟร์วอลล์ระดับเครือข่าย ชั้นที่อยู่เหนือ ufw ──────────────────────────
// ⭐⭐ ต่างจาก ufw ตรงที่มันกรองก่อนแพ็กเก็ตจะถึงเครื่องด้วยซ้ำ
//
//    ufw            ทำงานบนเครื่อง = ถ้าเครื่องถูกยึด คนที่ยึดปิด ufw ได้
//    Cloud Firewall ทำงานบนเครือข่ายของผู้ให้บริการ = ปิดจากในเครื่องไม่ได้
//
//    ⭐ สองชั้นนี้ต้อง "อนุญาตทั้งคู่" พอร์ตถึงจะเปิด ชั้นใดชั้นหนึ่งปิดก็จบ
//      ซึ่งแปลว่าถ้าวันหนึ่ง ufw ถูกปิดไปด้วยเหตุใดก็ตาม ชั้นนี้ยังกันอยู่
resource "digitalocean_firewall" "ladder" {
  name        = "${var.droplet_name}-basic"
  droplet_ids = [digitalocean_droplet.ladder.id]

  dynamic "inbound_rule" {
    for_each = var.allowed_ports
    content {
      protocol         = "tcp"
      port_range       = tostring(inbound_rule.value)
      source_addresses = ["0.0.0.0/0", "::/0"]
    }
  }

  // ⛔⛔ กับดักที่ทำให้เครื่องใช้งานไม่ได้ทันทีที่ apply
  //    Cloud Firewall ของ DigitalOcean ปฏิเสธ "ทั้งสองทาง" เป็นค่าเริ่มต้น
  //    ทันทีที่ผูกกับเครื่อง ถ้าไม่เขียนกฎขาออกไว้ **เครื่องจะออกเน็ตไม่ได้เลย**
  //    apt พัง · DNS พัง · อัปเดตอัตโนมัติพัง · และดูเหมือนเครื่องเจ๊ง
  //    ⚠️ ต่างจาก ufw ที่ขาออกอนุญาตเป็นค่าเริ่มต้น อย่าเอาความเคยชินมาใช้ข้ามเครื่องมือ
  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }

  outbound_rule {
    // ⚠️ ต้องมี ไม่งั้น DNS (พอร์ต 53 UDP) ใช้ไม่ได้ = เครื่องแปลชื่อโดเมนไม่ออก
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }

  outbound_rule {
    // ping ออกไปได้ ใช้ตอนไล่หาปัญหาเครือข่าย
    protocol              = "icmp"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }

  lifecycle {
    prevent_destroy = true
  }
}
