# ============================================================================
# ตัวอย่าง inventory สำหรับยิง playbook ไปหาเครื่องจริงผ่าน SSH
# ============================================================================
# ก๊อปเป็น inventory.ini แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
# ⛔ inventory.ini ตัวจริงถูก .gitignore ไว้ เพราะมีไอพีเครื่องจริงอยู่ข้างใน
#
# ⚠️ ลำดับที่ปลอดภัย ห้ามสลับ
#    1. รันครั้งแรกด้วย ansible_user=root และรหัสผ่านที่ผู้ให้บริการให้มา
#       (หรือกุญแจที่แปะไว้ตอนสั่งซื้อ ถ้าหน้าจัดการมีช่องให้แปะ)
#    2. playbook จะสร้างผู้ใช้ใหม่ + ใส่กุญแจ + ปิดรหัสผ่าน + ปิด root
#    3. ⭐ ทดสอบว่าเข้าด้วยผู้ใช้ใหม่ได้จริง **ก่อน** ปิดหน้าต่างเดิม
#       ssh deploy@<ไอพี>   ← ต้องเข้าได้ ถ้าไม่ได้ อย่าเพิ่งปิดหน้าต่างเก่า
#    4. เปลี่ยนบรรทัดข้างล่างมาใช้ผู้ใช้ใหม่ แล้วรันซ้ำเพื่อดูว่าได้ changed=0
#
# ⛔ ห้ามปิดหน้าต่าง SSH เดิมจนกว่าจะพิสูจน์ว่าเข้าทางใหม่ได้
#    นี่คือกฎข้อเดียวที่กันไม่ให้ล็อกตัวเองออกจากเครื่องถาวร

[vps]
# แทน 203.0.113.10 ด้วยไอพีจริง
myserver ansible_host=203.0.113.10

[vps:vars]
# ── รอบแรก ใช้ root ────────────────────────────────────────────────────
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/id_ed25519
# ถ้ายังไม่ได้แปะกุญแจไว้ ใช้รหัสผ่านแทนชั่วคราว โดยรันด้วย --ask-pass
# แล้วต้องมี sshpass ติดตั้งอยู่ด้วย

# ── รอบสองเป็นต้นไป สลับมาใช้ผู้ใช้ที่ playbook สร้างให้ ────────────────
# ansible_user=deploy
# ansible_become=true

ansible_python_interpreter=/usr/bin/python3

# ⚠️ ปิดการตรวจ host key เฉพาะรอบแรกที่ยังไม่รู้จักเครื่อง
#    ⛔ พอต่อสำเร็จรอบแรกแล้ว ให้ลบบรรทัดนี้ทิ้ง
#       ไม่งั้นจะเสียการป้องกันการถูกดักกลางทางไปตลอด
# ansible_ssh_common_args=-o StrictHostKeyChecking=no
