# ============================================================================
# ตัวอย่าง inventory สำหรับยิง playbook ไปหาเครื่องจริงหลายเครื่องพร้อมกัน
# ============================================================================
# ก๊อปเป็น inventory.ini แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
# ⛔ inventory.ini ตัวจริงถูก .gitignore ไว้ เพราะมีไอพีเครื่องจริงอยู่ข้างใน
#
# โครงนี้ทดสอบจริงแล้ว 2026-08-28 กับสองเครื่องคนละผู้ให้บริการคนละประเทศ
# ทั้งคู่ได้ changed=0 ในรอบที่สอง
# ============================================================================

[vps]
# ⭐ เครื่องสั่งงานดูแลตัวเองด้วย ใช้ connection=local
#    ไม่ต้องวนออกไปแล้ววนกลับผ่าน SSH ซึ่งเปลืองและต้องมีกุญแจของตัวเองไว้เข้าตัวเอง
ladder-01 ansible_host=127.0.0.1      ansible_connection=local

# ⚠️ ผู้ใช้เริ่มต้นของแต่ละเจ้าไม่เหมือนกัน อย่าเดา
#    DigitalOcean = root · เจ้าอื่นอาจเป็น ubuntu, admin หรือชื่อของผู้ให้บริการเอง
#    ⛔ เสียเวลาไปครึ่งชั่วโมงเพราะเดาว่าเป็น root ทั้งที่จริงเป็นชื่อผู้ให้บริการ
#    ดูจากอีเมลที่เขาส่งมา หรือล็อกอินครั้งแรกแล้วสั่ง whoami
thai-01   ansible_host=203.0.113.10   ansible_user=<ชื่อผู้ใช้จริงจากอีเมล>

[vps:vars]
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_python_interpreter=/usr/bin/python3
# ⚠️ เปิดเฉพาะรอบแรกที่ยังไม่รู้จัก host key ของเครื่องปลายทาง แล้วลบทิ้ง
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new

# ============================================================================
# ⛔ สิ่งที่ต้องเตรียมบนเครื่องปลายทางก่อน playbook จะทำงานได้ (ไก่กับไข่)
# ============================================================================
# playbook ตั้ง NOPASSWD sudo ให้เอง แต่มันต้องใช้ sudo ถึงจะทำได้
# จึงต้องเปิดประตูบานแรกด้วยมือครั้งเดียว บนเครื่องปลายทาง
#
#   mkdir -p ~/.ssh && chmod 700 ~/.ssh
#   echo '<กุญแจสาธารณะของเครื่องสั่งงาน>' >> ~/.ssh/authorized_keys
#   chmod 600 ~/.ssh/authorized_keys
#   echo '<ผู้ใช้> ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/90-<ผู้ใช้>
#   sudo chmod 440 /etc/sudoers.d/90-<ผู้ใช้>
#
# ⭐ ใช้กุญแจของ "เครื่องสั่งงาน" ไม่ใช่กุญแจส่วนตัวของคุณ
#    สร้างด้วย ssh-keygen -t ed25519 -C "ansible-control@<ชื่อเครื่อง>"
#    ถ้าเครื่องสั่งงานถูกเจาะ เพิกถอนกุญแจนั้นได้โดยไม่กระทบกุญแจส่วนตัวเลย
#
# ⚠️ ถ้า sshd จะเมินกุญแจ มันจะเงียบสนิทไม่บอกเหตุผล สาเหตุที่พบบ่อยที่สุดคือ
#    สิทธิ์ของ ~/.ssh ไม่ใช่ 700 หรือ authorized_keys ไม่ใช่ 600
#
# ============================================================================
# ลำดับที่ปลอดภัยตอนรัน
# ============================================================================
# 1. ansible -i inventory.ini vps -m ping            ← ต้อง SUCCESS ทุกเครื่องก่อน
# 2. ansible -i inventory.ini vps -m command -a "id -u" --become   ← ต้องได้ 0
# 3. รัน playbook รอบแรก
# 4. ⭐ ทดสอบว่าเข้าด้วยผู้ใช้ใหม่ได้จริง **ก่อน** ปิดหน้าต่างเดิม
#      ssh deploy@<ไอพี>
# 5. รันรอบสองเพื่อดูว่าได้ changed=0
#
# ⛔ ห้ามปิดหน้าต่าง SSH เดิมจนกว่าจะพิสูจน์ว่าเข้าทางใหม่ได้
#    นี่คือกฎข้อเดียวที่กันไม่ให้ล็อกตัวเองออกจากเครื่องถาวร
#    และสำคัญเป็นพิเศษกับเครื่องที่ผู้ให้บริการไม่มี console ให้
#
# ⚠️ ค่า ansible-playbook -e อ่านแบบ key=value คั่นด้วยช่องว่าง
#    กุญแจ SSH มีช่องว่างในตัว ต้องครอบด้วยเครื่องหมายคำพูดเดี่ยว
#    ไม่งั้นจะถูกหั่นเป็นหลายคู่แล้ว assert จะไม่ผ่าน (เจอกับตัว 2026-08-28)
#      -e "ssh_pubkey='$(cat ~/.ssh/id_ed25519.pub)'"
